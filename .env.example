# ── Multi-Agent CFO OS Configuration ──────────────────────────────────

# Database (required — CockroachDB or PostgreSQL connection string)
MACFO_DATABASE_URL=

# EGIS AI Runtime Governance (optional — set to "false" to disable)
EGISAI_ENABLED=true
EGISAI_API_KEY=
EGISAI_APP=multi-agent-cfo-os
EGISAI_ENV=production

# Signed Audit Ledger (optional — HMAC-SHA256 signing key for the append-only
# JSONL audit ledger at .meshcfo/audit.jsonl). If unset, a well-known test
# default is used so the offline demo/tests run without configuration. SET THIS
# to a real secret in production and keep it out of the repo.
AUDIT_LEDGER_KEY=
